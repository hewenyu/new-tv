<?xml version="1.0" encoding="utf-8"?>
<!-- A Control Center row under 更多: icon, title, a grey hint, chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="18dp"
    android:paddingEnd="12dp"
    android:background="@drawable/cc_row_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:tint="@color/cc_ink"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:textColor="@color/cc_ink"
        android:duplicateParentState="true"
        android:textSize="18sp"
        android:fontFamily="@string/font_medium"
        android:singleLine="true" />

    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:textColor="@color/cc_ink2"
        android:duplicateParentState="true"
        android:textSize="14sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_chevron"
        android:tint="@color/cc_ink2"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />
</LinearLayout>
