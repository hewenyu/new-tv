<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings: group cards (布局 / 外观 / 启动与主页 / 系统) of rows, docs/redesign-spec.md §4.C. A row is
     a focusable LinearLayout whose texts follow its focus (duplicateParentState); the three chip rows' inner
     LinearLayouts hold only their four chips, because reverseRow() rebuilds them for RTL. Rows and chips also grow
     when focused (LauncherSettingsActivity.scaleOnFocus), so cards and chip rows do not clip their children.
     TooManyViews: about 80 plain views, inflated once when the page opens and never rebound. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="TooManyViews"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tvh_bg"
    android:fillViewport="true"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingEnd="72dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/launcher_settings"
            android:textColor="@color/tvh_text"
            android:textSize="30sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/launcher_settings_subtitle"
            android:textColor="@color/tvh_text3"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- 布局 -->
        <TextView style="@style/SettingsSection" android:text="@string/settings_group_layout" />

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout android:id="@+id/reorderChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/reorder" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/reorder_row_hint" />
                </LinearLayout>
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsChoiceRow">
                <LinearLayout style="@style/SettingsChoiceLabel">
                    <TextView style="@style/SettingsChoiceTitle" android:text="@string/columns_label" />
                    <TextView style="@style/SettingsChoiceSubtitle" android:text="@string/columns_hint" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsChipBox">
                    <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                    <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                    <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                    <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingsChoiceRow">
                <LinearLayout style="@style/SettingsChoiceLabel">
                    <TextView style="@style/SettingsChoiceTitle" android:text="@string/rows_below_dock_label" />
                    <TextView style="@style/SettingsChoiceSubtitle" android:text="@string/rows_below_dock_hint" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsChipBox">
                    <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                    <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                    <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                    <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 外观 -->
        <TextView style="@style/SettingsSection" android:text="@string/settings_group_look" />

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout android:id="@+id/wallpaperChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/wallpaper_label" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/wallpaper_hint" />
                </LinearLayout>
                <TextView android:id="@+id/wallpaperValue" style="@style/SettingsRowValue" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout style="@style/SettingsChoiceRow">
                <LinearLayout style="@style/SettingsChoiceLabel">
                    <TextView style="@style/SettingsChoiceTitle" android:text="@string/dock_opacity_label" />
                    <TextView style="@style/SettingsChoiceSubtitle" android:text="@string/dock_opacity_hint" />
                </LinearLayout>
                <LinearLayout style="@style/SettingsChipBox">
                    <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                    <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                    <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                    <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/animationsChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/animations_label" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/animations_hint" />
                </LinearLayout>
                <TextView android:id="@+id/animationsValue" style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/advancedChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/advanced_effects" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/advanced_effects_warning" />
                </LinearLayout>
                <TextView android:id="@+id/advancedValue" style="@style/SettingsRowValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- 启动与主页 -->
        <TextView style="@style/SettingsSection" android:text="@string/settings_group_start" />

        <LinearLayout style="@style/SettingsCard">

            <!-- Only with open_on_start_choice, as before. -->
            <LinearLayout
                android:id="@+id/openOnStartChoice"
                style="@style/SettingsRow"
                android:visibility="gone">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/open_on_start_label" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/open_on_start_hint" />
                </LinearLayout>
                <TextView android:id="@+id/openOnStartValue" style="@style/SettingsRowValue" />
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/defaultHomeChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/home_settings" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/home_settings_help" />
                </LinearLayout>
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- 系统 -->
        <TextView style="@style/SettingsSection" android:text="@string/settings_group_system" />

        <LinearLayout style="@style/SettingsCard">

            <LinearLayout android:id="@+id/followThemeChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/follow_theme" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/follow_theme_hint" />
                </LinearLayout>
                <TextView android:id="@+id/followThemeValue" style="@style/SettingsRowValue" />
            </LinearLayout>

            <LinearLayout android:id="@+id/tvSettingsChoice" style="@style/SettingsRow">
                <LinearLayout style="@style/SettingsRowText">
                    <TextView style="@style/SettingsRowTitle" android:text="@string/tv_settings" />
                    <TextView style="@style/SettingsRowSubtitle" android:text="@string/tv_settings_hint" />
                </LinearLayout>
                <ImageView style="@style/SettingsRowChevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
