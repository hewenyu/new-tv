<?xml version="1.0" encoding="utf-8"?>
<!-- A Control Center status that needs attention (offline, no internet). tvh_warning cannot be read on the
     light focus fill, so focused it turns a dark amber (#8A4B00 on #F2F5FA, 6.2:1). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF8A4B00" />
    <item android:color="@color/tvh_warning" />
</selector>
