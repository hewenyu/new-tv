<?xml version="1.0" encoding="utf-8"?>
<!-- A Launcher settings chip's text: dark ink on the focus fill, tvh_text when chosen, tvh_text2 otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/tvh_focus_ink" />
    <item android:state_selected="true" android:color="@color/tvh_text" />
    <item android:color="@color/tvh_text2" />
</selector>
