<?xml version="1.0" encoding="utf-8"?>
<!-- A Control Center tile (16dp corners): tvh_raised, the light focus fill when focused (the panel also scales it). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tvh_focus_bg" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tvh_raised" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
